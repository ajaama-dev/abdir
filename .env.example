# Quote form delivery. All optional: with none set, enquiries are logged to the server console
# and the form still succeeds, so the site runs locally with zero setup.

# Resend (https://resend.com). Both must be set to send email.
RESEND_API_KEY=
# Where enquiries are sent. Comma-separate multiple addresses.
QUOTE_TO_EMAIL=

# Optional: POST the enquiry as JSON to this URL (Zapier, Make, n8n, CRM...). Failures are ignored.
WEBHOOK_URL=

# Optional extras
# QUOTE_FROM_EMAIL="Ashworth & Vale <quotes@yourdomain.co.uk>"   # must be a verified Resend domain
# NEXT_PUBLIC_SITE_URL=https://www.yourdomain.co.uk
